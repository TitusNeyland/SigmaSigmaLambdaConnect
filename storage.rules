rules_version = '2';

// Storage rules for Sigma Sigma Lambda Connect. Membership and roles are read from
// Firestore. See docs/data-model.md and tests/rules/storage.test.ts.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function memberPath() {
      return /databases/(default)/documents/members/$(request.auth.uid);
    }

    function rolePath() {
      return /databases/(default)/documents/roles/$(request.auth.uid);
    }

    function isApproved() {
      return signedIn()
        && firestore.exists(memberPath())
        && firestore.get(memberPath()).data.status == 'approved';
    }

    function isOfficer() {
      return isApproved()
        && firestore.exists(rolePath())
        && firestore.get(rolePath()).data.role in ['officer', 'admin'];
    }

    function isImageUnder(maxBytes) {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < maxBytes;
    }

    // Profile photos. Pending members can upload theirs during profile setup.
    match /avatars/{userId}/{fileName} {
      allow read: if isSelf(userId) || isApproved();
      allow create, update: if isSelf(userId) && isImageUnder(5 * 1024 * 1024);
      allow delete: if isSelf(userId);
    }

    // Photos for a post, stored under the author's ID.
    match /posts/{userId}/{postId}/{fileName} {
      allow read: if isApproved();
      allow create, update: if isSelf(userId) && isApproved() && isImageUnder(10 * 1024 * 1024);
      allow delete: if (isSelf(userId) && isApproved()) || isOfficer();
    }

    // Event hero photos.
    match /events/{eventId}/{fileName} {
      allow read: if isApproved();
      // Any approved member can host an event, and its photo uploads before the event is
      // saved. Members write only files named after themselves (`<uid>-<time>.jpg`), so
      // nobody can replace someone else's photo. Officers write any file. Which photo an
      // event shows is its photoURL, guarded by the Firestore rules.
      // Storage rules may read at most two Firestore documents per request (member and
      // role here), so this can't also look up the event's host.
      allow create, update: if isImageUnder(10 * 1024 * 1024)
        && (isOfficer()
            || (isApproved() && fileName.matches(request.auth.uid + '-.*')));
      allow delete: if isOfficer();
    }

    // A committee report's file (PDF, Word or photo), uploaded before the report is saved.
    // The submitter and officers can open it; a Cloud Function emails it. Never replaced.
    match /committeeReports/{userId}/{reportId}/{fileName} {
      allow read: if (isSelf(userId) && isApproved()) || isOfficer();
      allow create: if isSelf(userId)
        && isApproved()
        && resource == null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches(
             'application/pdf|application/msword|application/vnd[.]openxmlformats-officedocument[.].*|image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
