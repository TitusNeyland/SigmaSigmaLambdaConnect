{
  "expo": {
    "name": "Sigma Sigma Lambda Connect",
    "slug": "sigmasigmalambdaconnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sslconnect",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sigmasigmalambda.connect",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.sigmasigmalambda.connect",
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111111",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a profile photo or photos for your posts.",
          "cameraPermission": "Take a photo for your profile or a post."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Choose a profile photo or photos for your posts.",
          "savePhotosPermission": false,
          "granularPermissions": ["photo"],
          "preventAutomaticLimitedAccessAlert": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#111111",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Add chapter events to your calendar.",
          "remindersPermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan brothers' check-in codes at events.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
