{
  "name": "sigmasigmalambdaconnect",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.21",
    "expo-calendar": "~58.0.6",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.17",
    "expo-font": "~58.0.11",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.28",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "firebase": "^13.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^3.10.1",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.2",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.13",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run functions:build",
    "start:prod": "EXPO_PUBLIC_APP_ENV=production expo start",
    "start:emulators": "EXPO_PUBLIC_USE_EMULATORS=true expo start",
    "emulators": "firebase emulators:start",
    "functions:build": "npm --prefix functions run build",
    "test": "jest && vitest run -c vitest.tools.config.ts",
    "test:rules": "firebase emulators:exec --only firestore,storage,auth --project demo-ssl-rules \"vitest run -c vitest.rules.config.ts\"",
    "test:rules:ci": "firebase emulators:exec --only firestore,storage,auth --project demo-ssl-rules \"vitest run -c vitest.rules.config.ts --reporter=default --reporter=json --outputFile=rules-results.json\"",
    "test:unit": "jest",
    "test:tools": "vitest run -c vitest.tools.config.ts",
    "seed:emulators": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 tsx tools/seed/run.ts --project dev",
    "seed:dev": "tsx tools/seed/run.ts --project dev"
  },
  "private": true
}
