rules_version = '2';

// Security rules for Sigma Sigma Lambda Connect. See docs/data-model.md for the model and
// tests/rules/firestore.test.ts for the expected behavior. Anything not matched is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Who is asking ----------

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function memberPath(userId) {
      return /databases/$(database)/documents/members/$(userId);
    }

    function rolePath(userId) {
      return /databases/$(database)/documents/roles/$(userId);
    }

    function isApproved() {
      return signedIn()
        && exists(memberPath(request.auth.uid))
        && get(memberPath(request.auth.uid)).data.status == 'approved';
    }

    function roleIn(roles) {
      return exists(rolePath(request.auth.uid))
        && get(rolePath(request.auth.uid)).data.role in roles;
    }

    function isOfficer() {
      return isApproved() && roleIn(['officer', 'admin']);
    }

    function isAdmin() {
      return isApproved() && roleIn(['admin']);
    }

    // ---------- Validation helpers ----------

    function incoming() {
      return request.resource.data;
    }

    function changed() {
      return incoming().diff(resource.data).affectedKeys();
    }

    function isText(value, minLen, maxLen) {
      return value is string && value.size() >= minLen && value.size() <= maxLen;
    }

    function optionalText(data, field, maxLen) {
      return !(field in data) || isText(data[field], 0, maxLen);
    }

    function optionalBool(data, field) {
      return !(field in data) || data[field] is bool;
    }

    function isNow(value) {
      return value == request.time;
    }

    // ---------- Members ----------

    function memberProfileValid(data) {
      return isText(data.displayName, 1, 60)
        && isText(data.initiationTerm, 1, 40)
        && optionalText(data, 'headline', 80)
        && optionalText(data, 'bio', 150)
        && optionalText(data, 'email', 254)
        && optionalText(data, 'phone', 30)
        && optionalBool(data, 'showEmail')
        && optionalBool(data, 'showPhone')
        && (!('interests' in data) || (data.interests is list && data.interests.size() <= 10))
        && (!('photoURL' in data) || data.photoURL == null || data.photoURL is string)
        && (!('notificationPrefs' in data) || notificationPrefsValid(data.notificationPrefs));
    }

    // Push preferences from Settings (#15). Every key is optional; values must be true/false.
    function notificationPrefsValid(prefs) {
      return prefs is map
        && prefs.keys().hasOnly(['events', 'announcements', 'social', 'tasks'])
        && prefs.get('events', true) is bool
        && prefs.get('announcements', true) is bool
        && prefs.get('social', true) is bool
        && prefs.get('tasks', true) is bool;
    }

    function memberEditableFields() {
      return ['displayName', 'initiationTerm', 'headline', 'bio', 'interests', 'photoURL',
              'email', 'phone', 'notificationPrefs',
              'guidelinesAcceptedAt', 'updatedAt'];
    }

    match /members/{memberId} {
      allow read: if isSelf(memberId) || isApproved();

      // A new account creates its own pending profile. It can't approve itself.
      allow create: if isSelf(memberId)
        && incoming().keys().hasAll(['displayName', 'initiationTerm', 'status', 'createdAt'])
        && incoming().keys().hasOnly(memberEditableFields().concat(['status', 'createdAt']))
        && incoming().status == 'pending'
        && isNow(incoming().createdAt)
        && memberProfileValid(incoming());

      // Members edit their own profile fields, never their status.
      allow update: if isSelf(memberId)
        && changed().hasOnly(memberEditableFields())
        && memberProfileValid(incoming())
        // Guidelines acceptance (#38) records the real time; it can't be backdated or cleared.
        && (!changed().hasAny(['guidelinesAcceptedAt'])
            || incoming().guidelinesAcceptedAt == request.time);

      // Officers approve or decline other people.
      allow update: if isOfficer()
        && !isSelf(memberId)
        && changed().hasOnly(['status', 'reviewedBy', 'reviewedAt'])
        && incoming().status in ['approved', 'declined']
        && incoming().reviewedBy == request.auth.uid
        && isNow(incoming().reviewedAt);

      // Account deletion (#16), or an admin removing someone.
      allow delete: if isSelf(memberId) || isAdmin();

      // Private contact settings (#18). Only the member can read them, so a hidden email or
      // phone never reaches anyone else. The member doc above copies just the shown values.
      match /private/{docId} {
        allow read, delete: if isSelf(memberId);
        allow create, update: if isSelf(memberId)
          && docId == 'contact'
          && incoming().keys().hasOnly(['email', 'phone', 'showEmail', 'showPhone', 'updatedAt'])
          && optionalText(incoming(), 'email', 254)
          && optionalText(incoming(), 'phone', 30)
          && optionalBool(incoming(), 'showEmail')
          && optionalBool(incoming(), 'showPhone')
          && isNow(incoming().updatedAt);
      }
    }

    // ---------- Roles ----------

    match /roles/{userId} {
      allow read: if isSelf(userId) || isApproved();
      allow create, update: if isAdmin()
        && incoming().keys().hasOnly(['role', 'title'])
        && incoming().role in ['officer', 'admin']
        && optionalText(incoming(), 'title', 40);
      allow delete: if isAdmin();
    }

    // ---------- Events ----------

    function eventValid(data) {
      return isText(data.title, 1, 100)
        && data.category in ['meeting', 'service', 'learning', 'brotherhood', 'fundraiser',
                             'social', 'public']
        && isText(data.location, 1, 120)
        && data.startsAt is timestamp
        && data.rsvpDeadline is timestamp
        && optionalText(data, 'description', 2000)
        && optionalText(data, 'address', 200)
        && (!('feeCents' in data) || (data.feeCents is int && data.feeCents >= 0))
        // From the create and edit form (#27): an end after the start, a deadline by the start.
        && (!('endsAt' in data) || data.endsAt == null
            || (data.endsAt is timestamp && data.endsAt > data.startsAt))
        && data.rsvpDeadline <= data.startsAt
        && (!('photoURL' in data) || data.photoURL == null || data.photoURL is string)
        && (!('cancelled' in data) || data.cancelled is bool);
    }

    function eventPath(eventId) {
      return /databases/$(database)/documents/events/$(eventId);
    }

    function rsvpOpen(eventId) {
      let event = get(eventPath(eventId)).data;
      return request.time < event.rsvpDeadline && event.get('cancelled', false) == false;
    }

    match /events/{eventId} {
      allow read: if isApproved();
      allow create: if isOfficer()
        && eventValid(incoming())
        && incoming().createdBy == request.auth.uid
        && isNow(incoming().createdAt);
      // Officers edit or cancel. Who made it and when never change.
      allow update: if isOfficer()
        && eventValid(incoming())
        && !changed().hasAny(['createdBy', 'createdAt']);
      allow delete: if isOfficer();

      match /rsvps/{userId} {
        allow read: if isApproved();
        allow create, update: if isApproved()
          && isSelf(userId)
          && exists(eventPath(eventId))
          && rsvpOpen(eventId)
          && incoming().keys().hasOnly(['memberId', 'status', 'updatedAt'])
          && incoming().memberId == userId
          && incoming().status in ['going', 'maybe', 'not_going']
          && isNow(incoming().updatedAt);
        allow delete: if isApproved() && isSelf(userId) && rsvpOpen(eventId);
      }

      // Attendance is an officer check-in, separate from RSVPs.
      match /attendance/{userId} {
        allow read: if isOfficer() || (isApproved() && isSelf(userId));
        allow create, update: if isOfficer()
          && incoming().keys().hasOnly(['memberId', 'checkedInBy', 'checkedInAt', 'serviceHours',
                                        'walkIn'])
          && incoming().memberId == userId
          && incoming().checkedInBy == request.auth.uid
          && isNow(incoming().checkedInAt)
          && (!('serviceHours' in incoming())
              || (incoming().serviceHours is number
                  && incoming().serviceHours >= 0
                  && incoming().serviceHours <= 24))
          && optionalBool(incoming(), 'walkIn');
        allow delete: if isOfficer();
      }
    }

    // A member's attendance across all events (profile Activity tab, #13). Collection group
    // queries must filter on memberId == their own uid; officers can query everyone.
    match /{path=**}/attendance/{userId} {
      allow read: if isOfficer()
        || (isApproved() && resource.data.memberId == request.auth.uid);
    }

    // ---------- Posts ----------

    function postPath(postId) {
      return /databases/$(database)/documents/posts/$(postId);
    }

    function acceptedGuidelines() {
      return get(memberPath(request.auth.uid)).data.get('guidelinesAcceptedAt', null) != null;
    }

    match /posts/{postId} {
      allow read: if isApproved()
        && (resource.data.removed == false
            || resource.data.authorId == request.auth.uid
            || isOfficer());

      allow create: if isApproved()
        && acceptedGuidelines()
        && incoming().keys().hasOnly(['authorId', 'caption', 'photoPaths', 'eventId',
                                      'taggedMemberIds', 'allowComments', 'official',
                                      'removed', 'likeCount', 'commentCount', 'createdAt'])
        && incoming().authorId == request.auth.uid
        && isText(incoming().caption, 0, 2200)
        && incoming().photoPaths is list
        && incoming().photoPaths.size() <= 10
        && (incoming().photoPaths.size() > 0 || incoming().caption.size() > 0)
        && incoming().allowComments is bool
        && (incoming().official == false || (incoming().official == true && isOfficer()))
        && incoming().removed == false
        && incoming().likeCount == 0
        && incoming().commentCount == 0
        && (!('taggedMemberIds' in incoming())
            || (incoming().taggedMemberIds is list && incoming().taggedMemberIds.size() <= 20))
        && isNow(incoming().createdAt);

      // Authors edit the caption and comment setting.
      allow update: if isApproved()
        && resource.data.authorId == request.auth.uid
        && changed().hasOnly(['caption', 'allowComments', 'updatedAt'])
        && isText(incoming().caption, 0, 2200)
        && incoming().allowComments is bool;

      // Officers remove or restore a post.
      allow update: if isOfficer()
        && changed().hasOnly(['removed', 'updatedAt'])
        && incoming().removed is bool;

      allow delete: if isApproved()
        && (resource.data.authorId == request.auth.uid || isOfficer());

      match /comments/{commentId} {
        allow read: if isApproved();
        // A reply (#34) points at the comment it answers, which must be on the same post.
        allow create: if isApproved()
          && incoming().keys().hasOnly(['authorId', 'text', 'createdAt', 'replyToId'])
          && incoming().authorId == request.auth.uid
          && isText(incoming().text, 1, 1000)
          && isNow(incoming().createdAt)
          && (!('replyToId' in incoming())
              || exists(/databases/$(database)/documents/posts/$(postId)/comments/$(incoming().replyToId)))
          && get(postPath(postId)).data.allowComments == true
          && get(postPath(postId)).data.removed == false;
        allow delete: if isApproved()
          && (resource.data.authorId == request.auth.uid || isOfficer());

        // Likes on a comment (#34). The count is kept by a Cloud Function.
        match /likes/{userId} {
          allow read: if isApproved();
          allow create: if isApproved()
            && isSelf(userId)
            && exists(/databases/$(database)/documents/posts/$(postId)/comments/$(commentId))
            && incoming().keys().hasOnly(['memberId', 'createdAt'])
            && incoming().memberId == userId
            && isNow(incoming().createdAt);
          allow delete: if isApproved() && isSelf(userId);
        }
      }

      match /likes/{userId} {
        allow read: if isApproved();
        allow create: if isApproved()
          && isSelf(userId)
          && exists(postPath(postId))
          && incoming().keys().hasOnly(['memberId', 'createdAt'])
          && incoming().memberId == userId
          && isNow(incoming().createdAt);
        allow delete: if isApproved() && isSelf(userId);
      }
    }

    // ---------- Reports ----------

    match /reports/{reportId} {
      // Reporters stay anonymous to everyone but officers.
      allow read: if isOfficer();
      allow create: if isApproved()
        && incoming().keys().hasOnly(['reporterId', 'targetType', 'postId', 'commentId',
                                      'targetAuthorId', 'reason', 'details', 'status',
                                      'createdAt'])
        && incoming().reporterId == request.auth.uid
        && incoming().targetType in ['post', 'comment', 'member']
        // A member report (from their profile, #18) points at the person, not a post.
        && (incoming().targetType == 'member' || incoming().postId is string)
        && incoming().targetAuthorId is string
        && incoming().targetAuthorId != request.auth.uid
        && incoming().reason in ['spam', 'harassment', 'inappropriate', 'other']
        && optionalText(incoming(), 'details', 500)
        && incoming().status == 'open'
        && isNow(incoming().createdAt);
      allow update: if isOfficer()
        && changed().hasOnly(['status', 'resolvedBy', 'resolvedAt'])
        && incoming().status in ['open', 'kept', 'removed', 'restricted']
        && incoming().resolvedBy == request.auth.uid
        && isNow(incoming().resolvedAt);
      allow delete: if isAdmin();
    }

    // ---------- Blocks ----------

    match /blocks/{ownerId}/blocked/{otherId} {
      allow read, delete: if isSelf(ownerId);
      allow create: if isSelf(ownerId)
        && otherId != request.auth.uid
        && incoming().keys().hasOnly(['createdAt'])
        && isNow(incoming().createdAt);
    }

    // ---------- Hidden content (#36) ----------

    // Posts and comments a member reported, which the app hides for them. Only they see it.
    match /hidden/{userId}/items/{key} {
      allow read, delete: if isSelf(userId);
      allow create: if isSelf(userId)
        && isApproved()
        && incoming().keys().hasOnly(['targetType', 'postId', 'commentId', 'createdAt'])
        && incoming().postId is string
        && ((incoming().targetType == 'post' && key == 'post_' + incoming().postId)
            || (incoming().targetType == 'comment'
                && incoming().commentId is string
                && key == 'comment_' + incoming().postId + '_' + incoming().commentId))
        && isNow(incoming().createdAt);
    }

    // ---------- Push tokens (#25) ----------

    // Each phone a member signs in on. Only they can see or change theirs; Cloud Functions
    // read them with admin access to send. Pending members register too, so they hear
    // when they're approved.
    match /pushTokens/{userId}/tokens/{tokenId} {
      allow read, delete: if isSelf(userId);
      allow create, update: if isSelf(userId)
        && incoming().keys().hasOnly(['token', 'platform', 'updatedAt'])
        && isText(incoming().token, 1, 200)
        && incoming().platform in ['ios', 'android']
        && isNow(incoming().updatedAt);
    }

    // ---------- Chapter content officers manage ----------

    match /programs/{programId} {
      allow read: if isApproved();
      allow create, delete: if isOfficer();
      allow update: if isOfficer()
        && incoming().status in ['not_started', 'in_progress', 'at_risk', 'completed'];

      // "I can help" offers (#45). Members offer as themselves; officers see who offered.
      match /helpers/{userId} {
        allow read: if isOfficer() || (isApproved() && isSelf(userId));
        allow create: if isApproved()
          && isSelf(userId)
          && incoming().keys().hasOnly(['memberId', 'createdAt'])
          && incoming().memberId == userId
          && isNow(incoming().createdAt);
        allow delete: if isApproved() && isSelf(userId);
      }

      // Officers check milestones off from mobile (#44). Whoever checks it off is recorded.
      match /milestones/{milestoneId} {
        allow read: if isApproved();
        allow create, delete: if isOfficer();
        allow update: if isOfficer()
          && (!changed().hasAny(['done', 'doneAt', 'doneBy'])
              || (incoming().done == true
                  && incoming().doneBy == request.auth.uid
                  && isNow(incoming().doneAt))
              || (incoming().done == false
                  && incoming().doneBy == null
                  && incoming().doneAt == null));
      }
    }

    match /goals/{goalId} {
      allow read: if isApproved();
      allow write: if isOfficer();
    }

    // Officers post announcements (#43); a Cloud Function pushes them to members.
    match /announcements/{announcementId} {
      allow read: if isApproved();
      allow create: if isOfficer()
        && incoming().keys().hasOnly(['title', 'body', 'authorId', 'authorTitle', 'pinned',
                                      'createdAt'])
        && isText(incoming().title, 1, 100)
        && isText(incoming().body, 1, 2000)
        && incoming().authorId == request.auth.uid
        && optionalText(incoming(), 'authorTitle', 40)
        && incoming().pinned is bool
        && isNow(incoming().createdAt);
      allow update: if isOfficer()
        && changed().hasOnly(['title', 'body', 'pinned', 'updatedAt'])
        && isText(incoming().title, 1, 100)
        && isText(incoming().body, 1, 2000)
        && incoming().pinned is bool;
      allow delete: if isOfficer();
    }

    // Which announcements a member has read, for the unread dots. Only they see it.
    match /reads/{userId}/announcements/{announcementId} {
      allow read: if isSelf(userId);
      allow create, update: if isSelf(userId)
        && isApproved()
        && incoming().keys().hasOnly(['readAt'])
        && isNow(incoming().readAt);
    }

    // Computed by Cloud Functions with the Admin SDK. Clients only read.
    match /kpis/{periodId} {
      allow read: if isOfficer();
      allow write: if false;
    }
  }
}
